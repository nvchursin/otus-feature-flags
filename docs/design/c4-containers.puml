@startuml c4-containers
!include <C4/C4_Container>

title Feature Flags Service — containers

skinparam linetype ortho
skinparam nodesep 180
skinparam ranksep 150

Person(admin, "Администратор")
System_Ext(consumer, "Приложение")
System_Ext(identity_provider, "oauth2-провайдер")
System_Ext(cloud_services, "Cloud services")

Container_Boundary(feature_flags, "Feature Flags Service") {
    Container(crud, "ff-crud", "Web-service", "Админка, CRUD флагов, экспорт снапшотов")
    ContainerDb(database, "База конфигурации", "Database")
    Container(evaluator, "ff-evaluator", "API-приложение", "Вычисляет флаги")
}

Rel(admin, crud, "Управляет флагами")
Rel(crud, identity_provider, "Проверяет доступ")
Rel(crud, database, "Читает и записывает конфигурацию, версии и audit-log")
Rel(crud, cloud_services, "Публикует конфигурацию")
Rel(evaluator, cloud_services, "Проверяет версию и скачивает новый снапшот")

Rel(consumer, evaluator, "Запрашивает флаги")
@enduml
